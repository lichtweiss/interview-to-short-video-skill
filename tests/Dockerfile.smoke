FROM python:3.12-slim-bookworm
RUN apt-get -o Acquire::ForceIPv4=true update && apt-get install -y --no-install-recommends ffmpeg fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
RUN python -m pip install --no-cache-dir -r requirements.txt
ENV TEST_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
ENV TEST_FONT_FAMILY="Noto Sans CJK JP"
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
